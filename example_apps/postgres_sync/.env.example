# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Format is TOML, not dotenv. Every script reads it with tomllib and takes the
# FIRST table in the file, so the table name below is arbitrary — name it after
# your `snow` CLI connection if that helps you keep environments straight.

[default]

# ---------------------------------------------------------------------------
# Snowflake
# ---------------------------------------------------------------------------

# Account identifier, e.g. "myorg-myaccount" or a legacy locator.
account = "<account_identifier>"
user = "<username>"
role = "<role>"

# Warehouse used for the heavy work: creating and refreshing the BI tables.
# An adaptive warehouse, or any size you are willing to wait on. The fact table
# in this demo is 134.6M rows.
warehouse = "<warehouse>"

# Warehouse the dashboard queries through. An INTERACTIVE warehouse gives
# low-latency serving; a standard warehouse also works, just slower.
# See README "Snowflake: do I need interactive tables?".
interactive_warehouse = "<interactive_warehouse>"

# Auth. PROGRAMMATIC_ACCESS_TOKEN reads a PAT from token_file_path (gitignored
# via *.token). Key-pair auth is also supported by Cube's Snowflake driver —
# see README "Authentication".
authenticator = "PROGRAMMATIC_ACCESS_TOKEN"
token_file_path = "my.token"

# Default database/schema for the connectivity check only.
database = "<database>"
schema = "PUBLIC"

# ---------------------------------------------------------------------------
# The BI layer the dashboard reads (Snowflake)
# ---------------------------------------------------------------------------
# These may be interactive tables built by this project, or your own existing
# tables — the dashboard only needs the column names to match. Point them
# wherever your data lives.

bi_database = "<bi_database>"
bi_schema = "BI"
fact_table = "FCT_TRANSACTIONS"
dim_product_table = "DIM_PRODUCT"
dim_user_table = "DIM_USER"

# Source tables the BI layer is built FROM. With Snowflake Postgres this is the
# managed mirror; otherwise it is wherever you loaded the Postgres data.
source_database = "<source_database>"
source_schema = "SYNC_DEMO"

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
# Works with Snowflake Postgres, Amazon RDS/Aurora, Cloud SQL, or a plain
# self-hosted instance. Only the connection details differ.

PGHOST = "<postgres_host>"
PGPORT = 5432
PGUSER = "<postgres_user>"
PGPASSWORD = "<postgres_password>"
PGDATABASE = "postgres"

# Schema holding the three demo tables.
pg_schema = "sync_demo"

# TLS. "true" is fine for managed Postgres that presents a valid certificate.
# For RDS with certificate verification, see README "Postgres on RDS".
pg_ssl = true

# ---------------------------------------------------------------------------
# Dashboard behaviour
# ---------------------------------------------------------------------------

# The dashboard's time-range presets are anchored to the data's own end rather
# than "now", so the demo keeps working as it ages. Set these to your data's
# real bounds:
#   SELECT MIN(order_date), MAX(order_date) FROM <fact table>;
#
# data_end_ts matters for the 1h/6h presets: if your last day is only partly
# populated, anchoring at midnight lands in an empty tail and every tile reads
# "No rows in range". Use the true maximum.
data_start = "2024-09-12"
data_end = "2026-09-13"
data_end_ts = "2026-09-13T00:43:00"

# The dashboard issues one query per tile, all at once. Cube's driver pool
# defaults to 8, which makes the latency badges measure queueing instead of the
# engine. Keep this at or above the tile count, and identical for both sources.
tile_concurrency = 32

# ---------------------------------------------------------------------------
# Deployment (only needed for the container deploys; ignored when running local)
# ---------------------------------------------------------------------------

# Snowpark Container Services. Skip this block entirely if you deploy to
# EKS/GKE/AKS or plain Docker — see README "Deploying somewhere other than SPCS".
snow_connection = "<snow_cli_connection_name>"
image_registry = "<org>-<account>.registry.snowflakecomputing.com"
image_repo = "/<db>/<schema>/images"
compute_pool = "<compute_pool>"

# External access integration granting the containers egress to Postgres and to
# Snowflake. Only required when Postgres is not reachable from the pool by
# default. Leave as an empty string if you do not need one.
external_access_integration = "<external_access_integration>"

# Where the service object is created.
service_database = "<service_database>"
service_schema = "<service_schema>"
