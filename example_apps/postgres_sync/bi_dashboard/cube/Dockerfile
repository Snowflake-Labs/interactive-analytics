FROM cubejs/cube:v1.3.79

WORKDIR /cube/conf

COPY cube.js ./
# model/ is GENERATED by `uv run gen_env.py` from cubes.template.js. Run it before
# building, or the build fails here with "model/: not found".
COPY model/ ./model/

# Cube reads CUBEJS_* from the environment: on SPCS/Kubernetes from the rendered
# spec, locally from ../.env.cube via docker-compose. Nothing is baked in.
EXPOSE 4000
