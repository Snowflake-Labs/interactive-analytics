# Reference only. This file is GENERATED by `uv run gen_env.py` from ../.env --
# do not write it by hand, and never commit the generated .env.cube (it holds the
# Snowflake credential and the Postgres password).
#
# Shown here so you can see what Cube actually receives, and to make the two
# non-obvious requirements visible:
#
#   * CUBEJS_DATASOURCES must be declared, and must include "default" even though
#     no cube uses it.
#   * CUBEJS_CONCURRENCY and CUBEJS_DS_*_DB_MAX_POOL must be >= the tile count, and
#     equal on both sources, or the latency badges measure queueing.

CUBEJS_DEV_MODE=true
CUBEJS_LOG_LEVEL=info
CUBEJS_API_SECRET=<generated-per-run>
CUBEJS_PRE_AGGREGATIONS_SCHEMA=
CUBEJS_SCHEDULED_REFRESH_DEFAULT=false

CUBEJS_DATASOURCES=default,sf,pg
CUBEJS_CONCURRENCY=32

# Table names the data model binds to.
CUBE_SF_FACT=<bi_database>.BI.FCT_TRANSACTIONS
CUBE_SF_PRODUCT=<bi_database>.BI.DIM_PRODUCT
CUBE_SF_USER=<bi_database>.BI.DIM_USER
CUBE_PG_FACT=sync_demo.purchase_transactions
CUBE_PG_PRODUCT=sync_demo.product_catalog
CUBE_PG_USER=sync_demo.user_dimensions

# --- default (unused by any cube; mirrors sf) ---
CUBEJS_DB_TYPE=snowflake
CUBEJS_DB_SNOWFLAKE_ACCOUNT=<account_identifier>
CUBEJS_DB_USER=<username>
CUBEJS_DB_PASS=<snowflake_pat_or_password>
CUBEJS_DB_SNOWFLAKE_AUTHENTICATOR=PROGRAMMATIC_ACCESS_TOKEN
CUBEJS_DB_SNOWFLAKE_ROLE=<role>
CUBEJS_DB_SNOWFLAKE_WAREHOUSE=<interactive_warehouse>
CUBEJS_DB_NAME=<bi_database>
CUBEJS_DB_SCHEMA=BI

# --- dataSource: sf (Snowflake) ---
CUBEJS_DS_SF_DB_TYPE=snowflake
CUBEJS_DS_SF_DB_SNOWFLAKE_ACCOUNT=<account_identifier>
CUBEJS_DS_SF_DB_USER=<username>
CUBEJS_DS_SF_DB_PASS=<snowflake_pat_or_password>
CUBEJS_DS_SF_DB_SNOWFLAKE_AUTHENTICATOR=PROGRAMMATIC_ACCESS_TOKEN
CUBEJS_DS_SF_DB_SNOWFLAKE_ROLE=<role>
CUBEJS_DS_SF_DB_SNOWFLAKE_WAREHOUSE=<interactive_warehouse>
CUBEJS_DS_SF_DB_NAME=<bi_database>
CUBEJS_DS_SF_DB_SCHEMA=BI
CUBEJS_DS_SF_DB_MAX_POOL=32

# --- dataSource: pg (Postgres) ---
CUBEJS_DS_PG_DB_TYPE=postgres
CUBEJS_DS_PG_DB_HOST=<postgres_host>
CUBEJS_DS_PG_DB_PORT=5432
CUBEJS_DS_PG_DB_USER=<postgres_user>
CUBEJS_DS_PG_DB_PASS=<postgres_password>
CUBEJS_DS_PG_DB_NAME=postgres
CUBEJS_DS_PG_DB_SCHEMA=sync_demo
CUBEJS_DS_PG_DB_SSL=true
CUBEJS_DS_PG_DB_MAX_POOL=32

# --- web app (inlined into the browser bundle at build time) ---
NEXT_PUBLIC_DATA_START=2024-09-12
NEXT_PUBLIC_DATA_END=2026-09-13
NEXT_PUBLIC_DATA_END_TS=2026-09-13T00:43:00
