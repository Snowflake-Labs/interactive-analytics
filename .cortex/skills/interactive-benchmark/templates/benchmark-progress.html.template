<!--
  Interactive Warehouse Benchmark — Live progress tracker.

  This file is updated in-place every time a benchmark step completes or an
  escalation iteration finishes. It provides a real-time view of progress
  while the final report is not yet available.

  =============================================================================
  Placeholder reference
  =============================================================================

  Header
    {{SOLUTION_NAME}}           Solution name.
    {{RUN_DATE}}                YYYY-MM-DD of the run.
    {{LAST_UPDATED}}            ISO-8601 timestamp of last update.

  Steps (each step is a row in the progress table)
    {{STEP_ROWS}}               HTML <tr>… rows. Each row has:
                                - Step number
                                - Step name
                                - Status icon (✓ done, ► running, · pending)
                                - Status class ("done", "running", "pending")
                                - Optional detail/note

  Escalation history (only populated after Step 3.11 iterations begin)
    {{ESCALATION_ROWS}}         HTML <tr>… rows showing each iteration:
                                - Iteration #
                                - Warehouse size
                                - MAX_CLUSTER_COUNT
                                - Server-side P95 (ms)
                                - Decision (goal met / scale up / scale out)
                                If no escalation has happened yet, emit a single
                                row: "Awaiting first load test results."

  Current status
    {{CURRENT_STATUS}}          One-liner describing what is happening right now.
    {{STATUS_CLASS}}            "running" | "done" | "error"

  =============================================================================
-->
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Benchmark Progress — {{SOLUTION_NAME}}</title>
<meta http-equiv="refresh" content="10">
<style>
  :root { --snow-blue:#29B5E8; --snow-navy:#11567F; --ok:#1a9c5b; --warn:#c98600; --bad:#c74141; --bg:#f7fbfd; --fg:#1d2939; --muted:#5b6b7a; --card:#ffffff; --border:#e3ebf1; }
  * { box-sizing:border-box; }
  body { font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","Segoe UI",Roboto,Helvetica,Arial,sans-serif; margin:0; padding:0; background:var(--bg); color:var(--fg); line-height:1.5; }
  header { background:linear-gradient(135deg,var(--snow-navy),var(--snow-blue)); color:white; padding:22px 40px; }
  header h1 { margin:0 0 4px; font-size:20px; font-weight:600; }
  header .sub { opacity:.9; font-size:13px; }
  main { max-width:900px; margin:0 auto; padding:24px 40px 60px; }
  section { background:var(--card); border:1px solid var(--border); border-radius:8px; padding:20px 24px; margin-bottom:18px; }
  section h2 { margin:0 0 12px; font-size:16px; color:var(--snow-navy); border-bottom:2px solid var(--snow-blue); padding-bottom:6px; }
  table { width:100%; border-collapse:collapse; font-size:14px; }
  th,td { text-align:left; padding:7px 10px; border-bottom:1px solid var(--border); }
  th { background:#eef7fb; color:var(--snow-navy); font-weight:600; font-size:13px; }
  tr:last-child td { border-bottom:none; }
  td.num { text-align:right; font-variant-numeric:tabular-nums; font-family:"SF Mono",Menlo,monospace; }
  .status-icon { width:28px; text-align:center; font-size:16px; }
  .done .status-icon { color:var(--ok); }
  .running .status-icon { color:var(--snow-blue); }
  .pending .status-icon { color:var(--border); }
  .done td { color:var(--fg); }
  .pending td { color:var(--muted); }
  .running td { color:var(--snow-navy); font-weight:500; }
  .banner { padding:14px 18px; border-radius:8px; font-size:15px; font-weight:500; }
  .banner.running { background:#e8f6fc; color:var(--snow-navy); border:1px solid var(--snow-blue); }
  .banner.done { background:#e2f5ec; color:var(--ok); border:1px solid var(--ok); }
  .banner.error { background:#fbe1e1; color:var(--bad); border:1px solid var(--bad); }
  .timestamp { font-size:12px; color:var(--muted); margin-top:12px; text-align:right; }
  .pulse { display:inline-block; width:10px; height:10px; border-radius:50%; background:var(--snow-blue); animation:pulse 1.5s infinite; margin-right:8px; vertical-align:middle; }
  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.3} }
</style>
</head>
<body>
<header>
  <h1>Benchmark Progress — {{SOLUTION_NAME}}</h1>
  <div class="sub">Started {{RUN_DATE}}</div>
</header>
<main>

<div class="banner {{STATUS_CLASS}}">
  {{CURRENT_STATUS}}
</div>

<section>
  <h2>Steps</h2>
  <table>
    <thead><tr><th style="width:36px">#</th><th>Step</th><th style="width:36px"></th><th>Detail</th></tr></thead>
    <tbody>
{{STEP_ROWS}}
    </tbody>
  </table>
</section>

<section>
  <h2>Escalation History</h2>
  <table>
    <thead><tr><th class="num">#</th><th>Size</th><th class="num">Clusters</th><th class="num">P95 (ms)</th><th>Decision</th></tr></thead>
    <tbody>
{{ESCALATION_ROWS}}
    </tbody>
  </table>
</section>

<div class="timestamp">Last updated: {{LAST_UPDATED}}</div>

</main>
</body>
</html>
