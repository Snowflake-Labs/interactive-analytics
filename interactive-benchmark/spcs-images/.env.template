# Configuration for building and pushing benchmark container images.
# Sourced by build-and-push.sh.

# --- Snowflake connection ---------------------------------------------------
CONNECTION=DEFAULT
ROLE=SYSADMIN

# --- Image registry location ------------------------------------------------
# Database and schema where the image repository lives.
# These are created automatically by build-and-push.sh if they don't exist.
DB=IWB_SHARED
SCHEMA=SPCS
IMAGE_REPO=BENCHMARK_IMAGES

# --- Image names ------------------------------------------------------------
API_IMAGE=benchmark-api
LOCUST_IMAGE=benchmark-locust
IMAGE_TAG=latest
