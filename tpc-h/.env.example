# Example environment file for the TPC-H benchmark. Copy to .env and adjust.
CONNECTION_NAME=DEFAULT

# Solution name — all Snowflake object names are derived from this:
#   Database:              IW_<SOLUTION_NAME>_BENCH
#   Schema (standard):    <SOLUTION_NAME>_SF<SCALE>
#   Schema (interactive): <SOLUTION_NAME>_SF<SCALE>_IT
#   Load warehouse:       IW_<SOLUTION_NAME>_LOAD_WH
#   Standard warehouse:   <SOLUTION_NAME>_BENCH_WH_<SCALE>
#   Interactive warehouse: IW_<SOLUTION_NAME>_BENCH_WH_<SCALE>
# Can also be overridden per-run via --solution CLI flag.
SOLUTION_NAME=TPCH

# Default TPC-H scale factor: 1, 10, 100, or 1000
DEFAULT_SCALE=10
